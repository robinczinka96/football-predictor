# Football Predictor Configuration
# Copy this file to .env and fill in your API keys

# Football Data API (from football-data.org)
FOOTBALL_DATA_API_KEY=your_api_key_here

# News API (from newsapi.org)
NEWS_API_KEY=your_api_key_here

# Google Gemini API (from makersuite.google.com)
GEMINI_API_KEY=your_api_key_here

# Groq API (from console.groq.com)
GROQ_API_KEY=your_api_key_here

# API Football (from api-football.com) - Optional
API_FOOTBALL_KEY=your_api_key_here

# SmartProxy Configuration - Optional
# Only needed if using SmartProxy for scraping
SMARTPROXY_HOST=proxy.smartproxy.net
SMARTPROXY_PORT=3120
SMARTPROXY_USER=your_username
SMARTPROXY_PASS=your_password
